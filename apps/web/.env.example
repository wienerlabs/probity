# Probity web — environment template.
# Copy to .env.local for development. Never commit real keys.

# Helius — required for live on-chain ingest via @probity/solana.
# Get a key at https://dev.helius.xyz/ (free tier is enough for screening).
# When unset, the dashboard runs in demo mode against the fixtures shipped
# in apps/web/src/lib/fixtures.ts.
HELIUS_API_KEY=

# Optional: pin a specific cluster. Default mainnet.
# HELIUS_CLUSTER=mainnet

# Probity web — environment template.
# Copy to .env.local for development. Never commit real keys.

# Anthropic Claude — used by @probity/enrichment to extract a revenue
# model + governance shape from off-chain documents in live mode.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional: pin a Claude model. Defaults to claude-sonnet-4.6 in code.
# ANTHROPIC_MODEL=claude-sonnet-4.6

# Helius — required for live on-chain ingest via @probity/solana.
# Get a key at https://dev.helius.xyz/ (free tier is enough for screening).
# When unset, the dashboard runs in demo mode against the fixtures shipped
# in apps/web/src/lib/fixtures.ts.
HELIUS_API_KEY=

# Optional: pin a specific cluster. Default mainnet.
# HELIUS_CLUSTER=mainnet

# Birdeye public API — optional supplement to the token-list fallback.
# When set, the screening pipeline pulls a description + github +
# coingeckoId from Birdeye for mints whose Metaplex metadata is empty.
# Get a key at https://birdeye.so/developer.
BIRDEYE_API_KEY=

# CoinGecko demo / pro API key (optional). When set, raises the
# rate limit and surfaces categories, market_cap_rank, and a
# composite trust score into the enrichment context.
COINGECKO_API_KEY=
